# Copier en .env pour le développement local. Ne jamais commiter .env.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Obligatoire derrière HTTPS, ex. https://test.nodz.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# Préfixe d'URL si Nodz est servi sous un chemin (ex. /nodz derrière paintit) ; vide en local
NODZ_URL_PREFIX=
# Chemin de la base SQLite (défaut : ./db.sqlite3)
SQLITE_PATH=

# Utilisateur local créé par `python manage.py bootstrap`
NODZ_LOCAL_EMAIL=local@nodz.local
NODZ_LOCAL_PASSWORD=

# SMTP (vide = les emails s'affichent dans la console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nodz@localhost

# Gardien Premium (toolbox/premium.py) : Stripe Checkout en abonnement, webhook vers <site>/api/v1/toolbox/premium/webhook
# (événements checkout.session.completed, customer.subscription.updated, customer.subscription.deleted).
# Courrier par Postfix sur la machine : EMAIL_HOST=localhost, EMAIL_PORT=25, EMAIL_USE_TLS=0.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_LABEL=

# Boîte à outils IA
# Dossier des modèles GGUF (défaut : ./var/models)
MODELS_DIR=
# Jeton Hugging Face (dépôts privés ou limités ; vide = anonyme)
HF_TOKEN=
# Défauts d'iAqua : contexte et couches GPU « auto » (calculés selon la mémoire libre), « max » = toutes
# les couches sur GPU, ou un nombre ; threads 0 = cœurs physiques
LLM_CTX=auto
LLM_GPU_LAYERS=auto
LLM_THREADS=0
# Gardien : demandes traitées en même temps, demandes en attente au plus, recherche web (1 = oui)
GUARDIAN_WORKERS=1
GUARDIAN_QUEUE=8
GUARDIAN_WEB=1
# Outils portés d'iAqua : espace de travail par utilisateur, environnement Python dédié, serveurs MCP (JSON)
WORKSPACE_DIR=
GUARDIAN_PYENV=
MCP_SERVERS=
# Shell, Python, outils forgés et MCP pour le Gardien (compte administrateur seulement) : 1 pour autoriser
GUARDIAN_SHELL=0
# Binaire stable-diffusion.cpp pour les images (vide = cherché dans le PATH)
SD_BIN=
